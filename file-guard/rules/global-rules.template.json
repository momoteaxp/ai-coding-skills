{
  "name": "file-guard-global-rules",
  "version": "0.5.0",
  "description": "FileGuard C0 全局规则源——所有通道（L1/L2/C1/C5/C6）从此读取规则，禁止任何通道私自硬编码",
  "effective_since": "2026-09-19",
  "updated": "2026-10-23",
  "rules": {
    "blacklisted_names": {
      "file": [
        "^~\\$",
        "^新建[文本文档]*\\.",
        "\\.tmp$",
        "\\.bak$",
        "_v2\\.",
        "_v3\\.",
        "_v4\\.",
        "_v5\\.",
        "_v6\\.",
        "^test[-_]?(deploy|demo|reboot)\\.txt$",
        "^tmp_",
        "^temp_",
        "^nul$"
      ],
      "dir": [
        "^__pycache__$",
        "^\\.git$",
        "^\\.svn$",
        "^\\.hg$"
      ]
    },
    "blacklisted_root_patterns": [
      "^新建",
      "^_v[0-9]",
      "^test[-_]?(deploy|demo|reboot)",
      "^tmp_",
      "^temp_"
    ],
    "protected_dirs": {
      "_trash": {
        "allow_write": false,
        "note": "禁止直写，写入经 pre-write backup 或 L4 归位"
      },
      "_archive": {
        "allow_write": true,
        "note": "归档区，允许写入"
      }
    },
    "allowed_root_dirs": [
      "_rules",
      "_scratch",
      "_trash",
      "_archive",
      "scripts",
      "fgscripts",
      "project workspace",
      "设计思路",
      "评估报告",
      "日常交付",
      "数据分析",
      "剧本创作",
      "照片整理",
      "素材库",
      "学习资料",
      "产品",
      "其他",
      "inbox"
    ],
    "root_file_name_rule_default": "^(README|LICENSE|project_meta|_索引|_trash)",
    "archive_dirs": [
      "release",
      "archive",
      "backup",
      "demo/交付",
      "demo/打包层",
      "版本包归档"
    ],
    "trigger_words": {
      "verbs": [
        "新建",
        "创建",
        "做一个",
        "开发",
        "写"
      ],
      "nouns": [
        "项目",
        "skill",
        "插件",
        "程序",
        "App",
        "脚本",
        "工具"
      ],
      "extra": "搞一个XXX"
    },
    "checkpoint": {
      "history_limit": 5,
      "freshness_hours": 24,
      "read_scope": "current_project_only",
      "read_scope_note": "AI 读取 checkpoint 只允许指向【当前会话所属项目】的 _checkpoint。当前项目根由会话目录（L2 插件工厂 ctx.directory/worktree，env FILEGUARD_CURRENT_DIR 可覆盖）自路径上溯最近的 project_meta.json 确定。命中判据：目标路径落在某个 _checkpoint 目录、且其所属项目 ≠ 当前项目 → 无条件拦截（与 strict_mode 无关）并回执纠正到本项目。四条读取向量：read/grep/glob/bash（bash 按命令分词提取含 _checkpoint 的 token）。显式逃生通道：tools/checkpoint-manager.py load --project <目标项目根>（命令不含 _checkpoint 路径 token，故放行）——跨项目仅当用户显式点名目标项目时使用。当前项目未识别（无可上溯的 project_meta.json）时仅告警放行，不硬拦。read_scope 改为非 current_project_only 值即可一键关闭该拦截。",
      "read_vectors": [
        "read",
        "grep",
        "glob",
        "bash"
      ]
    },
    "naming_rules": {
      "date_prefix": "^\\d{4}-\\d{2}-\\d{2}[_-]",
      "mandatory_date_prefix_for": [
        "日常交付",
        "评估报告",
        "数据分析",
        "设计思路"
      ],
      "forbidden_defaults": [
        "新建文本文档",
        "新建文件夹",
        "未命名",
        "Untitled",
        "Document"
      ]
    },
    "read_only_semantics": {
      "purpose": "只读清单唯一真源语义。read_only_files / read_only_dirs 命中即拦截（strict_mode=true 项目 throw，其余 warn-only）；project_meta.json 永不拦截：meta 承载版本号、发版必然写入，仅受「用户确认 + 写前备份」约束。",
      "never_blocked_files": [
        "project_meta.json"
      ],
      "note": "project_meta.json 禁止进入任何类型模板的 read_only_files；所有消费通道（L2 src/file-guard-enforcer.js、C1 tools/enforcer.py、派生 tools/init.py）必须按本白名单豁免，并消费 read_only_dirs（Type C input 输入区只读防污染）。",
      "default_files": [
        "config/global-permission.json",
        "docs/README.md",
        "_索引.md"
      ],
      "default_dirs": [],
      "consumers": [
        "src/file-guard-enforcer.js",
        "tools/enforcer.py",
        "tools/init.py",
        "tools/sync-projects.py"
      ]
    },
