{
  "version": 1,
  "updated": "2026-10-27",
  "github": {
    "owner": "momoteaxp",
    "default_repo": "ai-coding-skills",
    "mode": "monorepo",
    "repo_visibility": "public"
  },
  "license": {
    "spdx": "MIT",
    "holder": "momoteaxp"
  },
  "contact": {
    "email": ""
  },
  "sanitize": {
    "denylist": [],
    "cross_project_terms": [],
    "allow_paths": [
      "docs/环境与配置.md",
      "config/sanitize-terms.json",
      "config/project-suggestions.json",
      "scripts/sanitize.py",
      "scripts/transforms.py"
    ]
  },
  "publish": {
    "enabled": false,
    "staging_dir": "publish-ready",
    "docs_policy": "internal",
    "tag_pattern": "{name}-v{version}"
  },
  "china_network": {
    "upload_proxy_env": "HTTPS_PROXY",
    "proxy": "",
    "download_mirrors": [
      "https://ghproxy.net/",
      "https://ghfast.top/",
      "https://cdn.jsdelivr.net/gh/{owner}/{repo}@"
    ]
  }
}
